{
  "name": "nodecal",
  "version": "0.1.0",
  "description": "Self-hosted mobile-first CalDAV calendar client",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "node --watch server/app.js",
    "android:sync": "cap sync android",
    "android:icons": "node scripts/generate-android-date-icons.mjs",
    "android:open": "cap open android",
    "android:build:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:build:release": "./android/build-apk.sh",
    "android:release": "./scripts/release-android.sh",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "chrono-node": "^2.7.0",
    "dotenv": "^16.4.0",
    "express": "^4.22.2",
    "rrule": "^2.8.1",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3"
  }
}
